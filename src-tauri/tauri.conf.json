{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Smart-Led-Calc",
  "version": "1.3.1",
  "identifier": "tech.smartvideo.ledcalc",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "SmartChoice LED Calculator",
        "width": 1280,
        "height": 860,
        "minWidth": 380,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Calculadora de paineis LED",
    "category": "Utility"
  }
}
